#!/bin/sh
set -eu

resolve_desktop_user() {
    candidate="${SUDO_USER:-}"
    if [ -z "$candidate" ] || [ "$candidate" = root ]; then
        candidate="${PKEXEC_UID:-}"
    fi
    [ -n "$candidate" ] || return 1

    entry="$(getent passwd "$candidate" 2>/dev/null || true)"
    [ -n "$entry" ] || return 1
    old_ifs=$IFS
    IFS=:
    set -- $entry
    IFS=$old_ifs
    uid=$3
    home=$6
    [ -n "$uid" ] && [ "$uid" -ge 1000 ] 2>/dev/null || return 1
    case "$home" in
        /*) ;;
        *) return 1
    esac
    printf '%s\n' "$home"
}

remove_profile_link() {
    target=$1
    link=$2
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        rm -- "$link"
    fi
}

if home="$(resolve_desktop_user)"; then
    remove_profile_link /usr/bin/fritz-power-monitor "$home/.local/bin/fritz-power-monitor"
    remove_profile_link /usr/share/applications/com.gpkvt.FritzPowerMonitor.desktop "$home/.local/share/applications/com.gpkvt.FritzPowerMonitor.desktop"
    remove_profile_link /usr/share/icons/hicolor/scalable/apps/com.gpkvt.FritzPowerMonitor.svg "$home/.local/share/icons/hicolor/scalable/apps/com.gpkvt.FritzPowerMonitor.svg"
fi

exit 0
