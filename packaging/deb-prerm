#!/bin/sh
set -eu

resolve_desktop_user() {
    candidate="${SUDO_USER:-}"
    if [ -z "$candidate" ] || [ "$candidate" = root ]; then
        candidate="${PKEXEC_UID:-}"
    fi
    [ -n "$candidate" ] || return 1

    entry="$(getent passwd "$candidate" 2>/dev/null || true)"
    [ -n "$entry" ] || return 1
    uid="$(printf '%s\n' "$entry" | cut -d: -f3)"
    desktop_user="$(printf '%s\n' "$entry" | cut -d: -f1)"
    desktop_home="$(printf '%s\n' "$entry" | cut -d: -f6)"
    [ -n "$uid" ] && [ "$uid" -ge 1000 ] 2>/dev/null || return 1
    [ -n "$desktop_user" ] || return 1
    case "$desktop_home" in
        /*) ;;
        *) return 1 ;;
    esac
    command -v runuser >/dev/null 2>&1 || return 1
}

remove_profile_link() {
    target=$1
    link=$2
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        # Never unlink beneath a user-controlled home as root.
        runuser -u "$desktop_user" -- rm -- "$link"
    fi
}

if resolve_desktop_user; then
    remove_profile_link /usr/bin/fritz-power-monitor "$desktop_home/.local/bin/fritz-power-monitor"
    remove_profile_link /usr/share/applications/com.gpkvt.FritzPowerMonitor.desktop "$desktop_home/.local/share/applications/com.gpkvt.FritzPowerMonitor.desktop"
    remove_profile_link /usr/share/icons/hicolor/scalable/apps/com.gpkvt.FritzPowerMonitor.svg "$desktop_home/.local/share/icons/hicolor/scalable/apps/com.gpkvt.FritzPowerMonitor.svg"
fi

exit 0
