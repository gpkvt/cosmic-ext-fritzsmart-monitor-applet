[Unit]
Description=FRITZ!Power Monitor (headless Prometheus exporter)
After=network.target
Documentation=https://gpkvt.github.io/cosmic-ext-fritzsmart-monitor-applet/guide.html

[Service]
Type=simple
# This non-GUI user service uses the endpoint enabled in the saved user config.
# Run fritz-power-monitor --headless --setup to configure it first.
ExecStart=/usr/bin/fritz-power-monitor --headless
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
